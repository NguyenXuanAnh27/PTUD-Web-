# Cấu hình Server
NODE_ENV=development
PORT=5000

# Cấu hình CORS (Frontend origin, phân tách dấu phẩy nếu nhiều origin)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Cấu hình SQL Server (thư viện mssql)
# Cách 1 (Khuyến nghị): Kết nối qua SQL Authentication (TCP/IP)
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=TuloCoffeeDB
DB_USER=sa
DB_PASSWORD=your_strong_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Cách 2 (Windows Authentication qua msnodesqlv8 nếu máy bật Trusted Connection)
# DB_TRUSTED_CONNECTION=false

# Cấu hình JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_min_32_chars
JWT_EXPIRES_IN=24h

